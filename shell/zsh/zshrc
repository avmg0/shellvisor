__sv_zdotdir="$ZDOTDIR"; ZDOTDIR="$SHELLVISOR_USER_ZDOTDIR"
[[ -r "$ZDOTDIR/.zshrc" ]] && source "$ZDOTDIR/.zshrc"
SHELLVISOR_USER_ZDOTDIR="$ZDOTDIR"; ZDOTDIR="$__sv_zdotdir"

# ---- Shellvisor hooks: cwd, command text, start/finish + exit code
autoload -Uz add-zsh-hook
__sv_osc() { printf '\e]%s\a' "$1" }
__sv_running=0
__sv_precmd() {
  local ec=$?
  (( __sv_running )) && __sv_osc "7770;end;$ec"
  __sv_running=0
  __sv_osc "7;file://${HOST}${PWD}"
  __sv_osc "7770;prompt"
}
__sv_preexec() {
  __sv_running=1
  __sv_osc "7770;cmd;$(print -rn -- "$1" | base64 | tr -d '\n')"
  __sv_osc "7770;start"
}
add-zsh-hook precmd __sv_precmd
add-zsh-hook preexec __sv_preexec

# non-login shells never read .zlogin: hand ZDOTDIR back to the user now
[[ -o login ]] || { ZDOTDIR="$SHELLVISOR_USER_ZDOTDIR"; unset SHELLVISOR_USER_ZDOTDIR SHELLVISOR_ORIG_ZDOTDIR; }
